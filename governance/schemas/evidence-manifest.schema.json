{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indrayuda.local/hermes/evidence-manifest.schema.json",
  "title": "Hermes Fleet Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "task_id", "owner", "verifier", "revision", "method", "result", "gate_verdict", "timestamp"],
  "properties": {
    "mission_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "verifier": {"type": ["string", "null"]},
    "artifact": {"type": ["string", "null"]},
    "revision": {"type": "string", "minLength": 7},
    "method": {"type": "string", "minLength": 1},
    "materialized_by": {"type": "string", "minLength": 1},
    "environment": {"type": ["string", "null"]},
    "route": {"type": ["string", "null"]},
    "state": {"type": ["string", "null"]},
    "viewport": {"type": ["string", "null"]},
    "gate_id": {"type": ["string", "null"], "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "critic": {"type": ["string", "null"], "minLength": 1},
    "previous_revision": {"type": ["string", "null"], "minLength": 7},
    "verdict_reason": {"type": "string", "minLength": 1},
    "result": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "gate_verdict": {"enum": ["PASS", "REVISE", "BLOCKED"]},
    "defect_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_gates_passed", "thresholds_met", "blocking_findings", "criteria"],
      "properties": {
        "hard_gates_passed": {"type": "boolean"},
        "thresholds_met": {"type": "boolean"},
        "blocking_findings": {"type": "integer", "minimum": 0},
        "weighted_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "minimum_dimension_score": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "evidence"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "status": {"enum": ["PASS", "FAIL", "BLOCKED", "N_A"]},
              "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
              "note": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "artifact_proof": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "locator", "criterion_ids"],
        "properties": {
          "kind": {"enum": ["source", "test-output", "screenshot", "recording", "log", "measurement", "research-source", "other"]},
          "locator": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
          "criterion_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "captured_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "escalation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "decision": {"type": ["string", "null"]}
      },
      "required": ["reason", "to"]
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "source_anti_slop_zero_matches": {"type": "boolean"},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
